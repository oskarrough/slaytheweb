---
import PageHeader from '../components/PageHeader.astro'
import Layout from '../layouts/Layout.astro'
import '../styles/index.css'

const sounds = ['startGame', 'startTurn', 'endTurn', 'selectCard', 'cardToHand', 'playCard']
---

<script>
	import * as sounds from '../sounds.js'

	const buttons = document.querySelectorAll('menu.sounds button')
	buttons.forEach((button) => {
		button.addEventListener('click', (event) => {
			const target = event.currentTarget
			const sound = target.dataset.sound
			console.log('playing', sound)
			sounds[sound]()
		})
	})

	document.querySelectorAll('[data-sfx]').forEach((el) => {
		el.addEventListener('click', () => {
			const {sfx, coin} = el.dataset
			if (sfx === 'whoosh') {
				sounds.playWhoosh(0.6)
			} else if (coin) {
				sounds.playCoin(coin)
			} else if (sfx) {
				const frequency = parseFloat(sfx)
				sounds.beep(frequency, frequency * 2, 0.3)
			}
		})
	})
</script>

<Layout title="Sounds, Slay the Web">
	<div class="Container">
		<PageHeader title="Sounds" subtitle={`${sounds.length + 7} effects`} />

		<section>
			<h2>Game sounds</h2>
			<div class="Grid">
				{sounds.map((s) => (
					<figure>
						<button type="button" data-sound={s}>{s}</button>
					</figure>
				))}
			</div>
		</section>

		<section>
			<h2>Tones</h2>
			<div class="Grid">
				<figure><button type="button" data-sfx="220">220hz</button></figure>
				<figure><button type="button" data-sfx="440">440hz</button></figure>
				<figure><button type="button" data-sfx="880">880hz</button></figure>
				<figure><button type="button" data-sfx data-coin="minor">Coin minor</button></figure>
				<figure><button type="button" data-sfx data-coin="major">Coin major</button></figure>
				<figure><button type="button" data-sfx data-coin="pentatonic">Coin penta</button></figure>
				<figure><button type="button" data-sfx="whoosh">Whoosh</button></figure>
			</div>
		</section>
	</div>
</Layout>
